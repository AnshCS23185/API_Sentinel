# ==============================================================================
# API Sentinel — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` for local Docker Compose development, or configure
# the appropriate variables in your cloud hosting provider (e.g., Render).
# DO NOT commit real production credentials to version control.
# ==============================================================================

# ==============================================================================
# 1. LOCAL DOCKER COMPOSE CONFIGURATION (Local Dev Only)
# ==============================================================================
COMPOSE_PROJECT_NAME=api-sentinel

POSTGRES_DB=api_sentinel
POSTGRES_USER=api_sentinel
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

BACKEND_PORT=8000
GATEWAY_PORT=8001
DEMO_API_PORT=8002
FRONTEND_PORT=5173

# ==============================================================================
# 2. BACKEND RUNTIME VARIABLES (Render / Production / Local Docker)
# ==============================================================================

# Database Connection URL:
# For Render PostgreSQL: Render provides `postgresql://...` or `postgres://...`.
# The application automatically normalizes this to `postgresql+psycopg://...`.
# Local Docker Compose default: postgresql+psycopg://api_sentinel:SentinelPg2026@postgres:5432/api_sentinel
DATABASE_URL=postgresql+psycopg://api_sentinel:replace-with-secure-db-password@postgres:5432/api_sentinel

# Redis Connection URL:
# Supports redis:// (standard) and rediss:// (TLS-encrypted Redis).
# Local Docker default: redis://redis:6379/0
# Render Key-Value / Upstash example: rediss://default:replace-with-redis-token@host:6379/0
REDIS_URL=redis://redis:6379/0

# JWT Security Secret:
# Required for Admin JWT signing. Must be at least 32 characters long.
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long

# Initial Administrator Bootstrap:
# Provisioned automatically upon initial database startup/migration.
INITIAL_ADMIN_EMAIL=admin@sentinel.local
INITIAL_ADMIN_PASSWORD=replace-with-strong-admin-password

# CORS Allowed Origins:
# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcard *).
# Local default: http://localhost:5173,http://127.0.0.1:5173
# Production example: https://api-sentinel-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Web Application Base URL:
# Used by backend email templates when constructing consumer login and alert URLs.
# Local default: http://localhost:5173
# Production example: https://api-sentinel-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# Demo Upstream API Target:
# Base URL for the companion demo API service.
# Local default: http://demo-api:8002
# Production example: https://api-sentinel-demo.onrender.com
DEMO_API_URL=http://demo-api:8002

# Allowed Upstream Target Allowlist (SSRF Protection):
# Comma-separated list of allowed target base URLs.
# Any upstream request forwarded by the gateway must match this list.
# Local default: http://demo-api:8002
# Production example: https://api-sentinel-demo.onrender.com
ALLOWED_UPSTREAM_TARGETS=http://demo-api:8002

# SMTP Notification Credentials (Optional for email dispatch):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@apisentinel.local
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@apisentinel.local
EMAILS_FROM_NAME=API Sentinel System

# ==============================================================================
# 3. FRONTEND BUILD VARIABLES (Vite SPA / Static Web Service)
# ==============================================================================

# Backend Gateway & Management API Base URL:
# Used at build time by Vite to configure API communication endpoints.
# Local Docker / npm run dev default: http://localhost:8000
# Production example: https://api-sentinel-backend.onrender.com
VITE_API_URL=http://localhost:8000