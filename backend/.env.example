# ==========================================
# API Sentinel — Backend Environment Example
# ==========================================

# Database Connection URL:
# Normalized automatically from postgresql:// or postgres:// to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://api_sentinel:SentinelPg2026@postgres:5432/api_sentinel

# Redis Connection URL (supports redis:// and rediss://):
REDIS_URL=redis://redis:6379/0

# JWT Signing Secret (must be at least 32 characters long):
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long

# Initial Administrator Bootstrap:
INITIAL_ADMIN_EMAIL=admin@sentinel.local
INITIAL_ADMIN_PASSWORD=replace-with-strong-admin-password

# CORS Allowed Origins (comma-separated list):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Web Application URL (used in email templates):
FRONTEND_URL=http://localhost:5173

# Demo Upstream API Target:
DEMO_API_URL=http://demo-api:8002

# Allowed Upstream Targets Allowlist (comma-separated list):
ALLOWED_UPSTREAM_TARGETS=http://demo-api:8002

# ==========================================
# SMTP Email Server Credentials (Optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@apisentinel.local
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@apisentinel.local
EMAILS_FROM_NAME=API Sentinel System
